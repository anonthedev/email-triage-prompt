# Hosted Jev: https://api.typesafe.ai
# Local Laya:  http://localhost:11435
TYPESAFE_BASE_URL=https://api.typesafe.ai

# Hosted Jev requires a bearer token. Local Laya accepts any value, often "local".
TYPESAFE_API_KEY=

# jev-latest or laya
TYPESAFE_MODEL=jev-latest

# Google OAuth web client. Enable the Gmail API on the same project.
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# openssl rand -base64 32
AUTH_SECRET=
